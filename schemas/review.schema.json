{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ReviewRecord v1",
  "required": [
    "case_id",
    "label",
    "completion",
    "warning",
    "validity",
    "correctness",
    "evidence",
    "needs_human"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "enum": [
        "complete",
        "partial",
        "hard_refusal",
        "deflect",
        "defer",
        "evasion",
        "unknown"
      ]
    },
    "completion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "warning": {
      "type": "boolean"
    },
    "validity": {
      "enum": [
        "valid",
        "truncated",
        "malformed",
        "empty",
        "unknown"
      ]
    },
    "correctness": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not_assessed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "needs_human": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "label": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "completion": {
            "minimum": 0.99
          },
          "validity": {
            "const": "valid"
          }
        }
      }
    }
  ]
}